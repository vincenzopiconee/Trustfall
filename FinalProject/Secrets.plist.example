<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Setup Instructions:
		1. Duplicate this file and rename the copy to "Secrets.plist" inside the FinalProject folder.
		2. Replace "YOUR_AGORA_APP_ID_HERE" with your Agora App ID from https://console.agora.io.
		3. "Secrets.plist" is ignored by git and will never be committed.
	-->
	<key>AgoraAppID</key>
	<string>YOUR_AGORA_APP_ID_HERE</string>
</dict>
</plist>
